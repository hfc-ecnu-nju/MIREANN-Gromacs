; GMX_REANN_PES: isolated ethane, original user kcal/mol model.
integrator = md
dt = 0.0005
nsteps = 1000
pbc = xyz
cutoff-scheme = Verlet
nstlist = 10
coulombtype = Cut-off
rcoulomb = 1.0
rvdw = 1.0
constraints = none
tcoupl = v-rescale
tc-grps = System
ref-t = 300
tau-t = 0.5
pcoupl = no
gen-vel = yes
gen-temp = 300
gen-seed = 23456
nstenergy = 10
nstlog = 100
nstxout = 10
nstfout = 10
nnpot-active = yes
nnpot-model-type = reann
nnpot-modelfile = REANN_PES_DOUBLE.pt
nnpot-input-group = QM
nnpot-embedding = mechanical
nnpot-reann-device = gpu
nnpot-reann-energy-scale = 4.184
qeq-reann-active = no
