; GMX_MIREANN: supplied MECL solution, short interface smoke test.
integrator = md
dt = 0.0001
nsteps = 5
cutoff-scheme = Verlet
nstlist = 10
coulombtype = PME
coulomb-modifier = None
rcoulomb = 1.0
rvdw = 1.0
vdw-modifier = Potential-shift
DispCorr = EnerPres
pbc = xyz
fourierspacing = 0.12
pme-order = 4
constraints = none
tcoupl = v-rescale
tc-grps = System
tau-t = 0.5
ref-t = 300
pcoupl = no
gen-vel = yes
gen-temp = 300
gen-seed = 20261023
nstcalcenergy = 1
nstenergy = 1
nstlog = 1
nstxout = 1
nstfout = 1
mireann-active = yes
mireann-model = REANN_CHA_DOUBLE.pt
mireann-atoms = 1 2 3 4 5 6
mireann-elements = Cl Cl C H H H
mireann-center-atom = 1
mireann-mm-cutoff = 25
mireann-mm-selection = residue
mireann-switch-width = 0
mireann-energy-scale = 4.184
mireann-device = cpu
mireann-threads = 1
mireann-charge-log = charges.log
mireann-energy-log = embedding.csv
mireann-profile = profile.csv
nnpot-active = yes
nnpot-model-type = reann
nnpot-modelfile = REANN_PES_DOUBLE.pt
nnpot-input-group = QM
nnpot-embedding = mechanical
nnpot-reann-device = cpu
nnpot-reann-energy-scale = 4.184
