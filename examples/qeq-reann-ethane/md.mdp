integrator = md
dt = 0.0005
nsteps = 500
pbc = xyz
cutoff-scheme = Verlet
nstlist = 10
verlet-buffer-tolerance = -1
rlist = 1.4
rcoulomb = 1.2
rvdw = 1.2
coulombtype = Cut-off
coulomb-modifier = None
vdw-modifier = Potential-shift
constraints = none
tcoupl = no
pcoupl = no
comm-mode = Linear
nstcomm = 1
nstcalcenergy = 1
nstenergy = 1
nstlog = 100
nstxout = 1
nstvout = 1
nstfout = 1
gen-vel = yes
gen-temp = 300
gen-seed = 23456

; GMX_QEQ_REANN: model q(e), topology masses u, model coordinates Angstrom
qeq-reann-active = yes
qeq-reann-model = REANN_CHA_DOUBLE.pt
qeq-reann-atoms = 1 2 3 4 5 6 7 8
qeq-reann-elements = C H H H C H H H
qeq-reann-device = cpu
qeq-reann-threads = 1
qeq-reann-pbc = 0 0 0
qeq-reann-charge-log = charges.log
qeq-reann-profile = qeq-profile.csv
